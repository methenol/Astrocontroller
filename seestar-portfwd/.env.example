# Copy to .env. Anything unset is prompted for on `docker compose run`.
# SEESTAR_USER=you@example.com
# SEESTAR_PASSWORD=            # omit to be prompted (keeps it off disk)
# SEESTAR_SN=                  # optional; auto-selected if you have one telescope
# SEESTAR_SRC_ID=             # optional; pin the client id across runs

# The supervisor is the container's entry point: it owns the one tunnel process and with it the
# scope's one remote session, reconnects a lost one and always releases it. compose.yaml sets
# AUTOSTART=1 so `docker compose up` connects at once; Astrocontroller's compose leaves it at 0
# and drives Connect/Disconnect over the control API instead.
# SEESTAR_TUNNEL_AUTOSTART=1
# SEESTAR_TUNNEL_CONTROL_PORT=4710    # the Connect/Disconnect/status API (also the healthcheck)
# SEESTAR_TUNNEL_CONTROL_TOKEN=       # require Authorization: Bearer <token> on it
