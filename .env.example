# ── Telescope driver ─────────────────────────────────────────────────────────
# dwarf (DWARFLAB Dwarf 3, the default) | seestar (ZWO Seestar). Each driver keeps its own data
# folder by default (./data for dwarf, ./data-seestar for seestar) so the agents do not mix.
TELESCOPE_DRIVER=dwarf

# ── Telescope ────────────────────────────────────────────────────────────────
# IP of the Dwarf 3 on your network (STA mode). In AP mode it is 192.168.88.1.
# Can also be changed from the web UI (System → Telescope IP), which overrides this value.
DWARF_HOST=10.0.0.196
# Push time, timezone and location to the scope whenever we (re)connect.
DWARF_AUTO_SYNC_TIME_LOCATION=true
# The protocol header the scope sees on every request. `app` (2.3) is what the official DWARFLAB
# app sends, so it is the default; `sdk` (1.20) is what the third-party SDK sends — set it only if
# a firmware refuses 2.3.
DWARF_PROTOCOL_HEADER=app

# ── ZWO Seestar (only read when TELESCOPE_DRIVER=seestar) ────────────────────
# local = the scope on your network; zwo = ZWO Telescope Network (a remote scope, e.g. a hosted
# S30), reached through the seestar-portfwd tunnel.
#SEESTAR_CONNECTION=local
# local: the scope's IP (or seestar.local).
#SEESTAR_HOST=seestar.local
# zwo: where the tunnel's services are. docker-compose.yml sets it to the seestar-portfwd
# container (on the seestar network); outside Docker it defaults to 127.0.0.1.
#SEESTAR_TUNNEL_HOST=seestar-portfwd
# The supervisor inside the tunnel container (seestar-portfwd/src/supervisor.py): Connect asks it for
# the scope's one remote session, Disconnect releases it, so the container does what the app's
# button says instead of holding a session from boot to shutdown. It listens on
# SEESTAR_TUNNEL_HOST:4710; change these only when the tunnel is elsewhere. false = watch the
# forwarded port only, as with a tunnel you run yourself.
#SEESTAR_TUNNEL_CONTROL=true
#SEESTAR_TUNNEL_CONTROL_HOST=seestar-portfwd
#SEESTAR_TUNNEL_CONTROL_PORT=4710
# only needed when the container sets the same token
#SEESTAR_TUNNEL_CONTROL_TOKEN=
# The tunnel gives the scope back if Astrocontroller stops refreshing this often, so a controller
# that died cannot leave the telescope occupied; 0 = hold it until Disconnect.
#SEESTAR_TUNNEL_LEASE_S=180
#SEESTAR_RPC_PORT=4700
#SEESTAR_IMAGE_PORT=4800
#SEESTAR_WIDE_IMAGE_PORT=4804
# The device's file server: 80 on the Docker network, 8080 when seestar-portfwd publishes it on loopback.
#SEESTAR_HTTP_PORT=80
# ZWO Telescope Network handshake key: the official Seestar app's key, extracted from the APK
# (seestarpy's extract_pem). It is not shipped with Astrocontroller. One key for every ZWO profile;
# a Seestar on the LAN does not use it. Put the file in ./keys (mounted read-only at /keys).
SEESTAR_KEY_PATH=/keys/seestar.pem
#SEESTAR_AUTO_SYNC_TIME_LOCATION=true
# ZWO account for the single-telescope setup (docker-compose.yml passes these to seestar-portfwd,
# which then runs it in tunnel slot 0). With the profile hub, set each ZWO profile's account in
# Profiles → Edit instead and leave these unset.
#SEESTAR_USER=you@example.com
#SEESTAR_PASSWORD=
#SEESTAR_SN=
#SEESTAR_COUNTRY=US

# ── Starfront Observatories (Seestar over ZWO Telescope Network only) ──────
# true offers "Autonomous nights" on the agent tab: every night the roof over the scope opens, the
# agent is put on duty until astronomical dawn, images targets from the planner from astronomical
# dark, transfers each target when the next one starts stacking, and at dawn transfers the last and
# stows the arm. It can be left on for days or weeks.
#STARFRONT_REMOTE_ZWO=false
# The building the scope is in: its roof (Starfront's roof API) is the one followed. Empty: any open
# roof wakes the agent, its telescope confirms its own roof, and the checks narrow down the building.
#STARFRONT_BUILDING=
# A roof still reported closed at this local time is checked with the telescope.
#STARFRONT_ROOF_CHECK_TIME=19:00
#STARFRONT_POLL_S=60
#STARFRONT_ROOF_URL=https://alpaca-api.tx.starfront.space/api/v1/roof/state
# Autonomous nights: between its phases the agent parks and disconnects the scope; the night's duty
# starts this many minutes before dark so the agent can connect again (5–10 min over ZWO)
#STARFRONT_CONNECT_LEAD_MIN=25

# ── Seestar in Docker (docker-compose.yml) ───────────────────────────────────
# Start the seestar-portfwd tunnel container with Astrocontroller: needed by every profile that
# connects over ZWO Telescope Network (Profiles → a Seestar with ZWO on, e.g. at Starfront). It stays
# idle until such a profile is activated. Comment out only if no profile will ever use ZWO.
COMPOSE_PROFILES=seestar
# One tunnel per ZWO profile in that container (each with its own account, serial and ports); the
# profile hub asks for them on port 4709. 0 = the old single tunnel from SEESTAR_USER above.
SEESTAR_TUNNEL_MULTI=1
# The tunnel lives in this project (seestar-portfwd/, vendored from github.com/Phaeilo/seestar-portfwd
# and supervised); point this elsewhere only to build a different checkout.
#SEESTAR_PORTFWD_DIR=./seestar-portfwd
# Set to 1 to have the tunnel take the scope as soon as its container starts, instead of waiting for
# the app's Connect (for a container that runs the tunnel on its own).
#SEESTAR_TUNNEL_AUTOSTART=0
# The ThroughTek SDK set the tunnel is built with: T (default) is the one the current Seestar app
# loads, and the one an S50 Pro on firmware 9.75 connects with; empty builds the set seestar-portfwd
# ships (fails there with Connect_Ex -42). T needs a seestar-portfwd checkout with the TUTK_SUFFIX
# build option and the T libraries from your copy of the app in tunnel_libs/.
#SEESTAR_TUTK_SUFFIX=T
# Keep the Seestar agent's data apart from the Dwarf's (host folder mounted at /data).
#DATA_PATH=./data-seestar
# Also publish the telescope's services on the host for other software (optional):
#COMPOSE_FILE=docker-compose.yml:docker-compose.seestar-ports.yml
# ...on this address (keep loopback unless the network is trusted), and these host ports.
# Delete a service's line in docker-compose.seestar-ports.yml to not publish it.
#SEESTAR_PUBLISH_ADDR=127.0.0.1
#SEESTAR_PUBLISH_RPC_PORT=4700
#SEESTAR_PUBLISH_IMAGE_PORT=4800
#SEESTAR_PUBLISH_WIDE_IMAGE_PORT=4804
#SEESTAR_PUBLISH_RTSP_PORT=4554
#SEESTAR_PUBLISH_WIDE_RTSP_PORT=4555
#SEESTAR_PUBLISH_HTTP_PORT=8081
#SEESTAR_PUBLISH_FILE_API_PORT=4801
#SEESTAR_PUBLISH_ALPACA_PORT=32323
#SEESTAR_PUBLISH_FW_CONTROL_PORT=4350
#SEESTAR_PUBLISH_FW_UPLOAD_PORT=4361
#SEESTAR_PUBLISH_SMB_PORT=4445
#SEESTAR_PUBLISH_SSH_PORT=2222

# ── Seestar without Docker ───────────────────────────────────────────────────
# Start and supervise the tunnel yourself from here (restart on exit, SIGINT on stop); empty = you
# run it. Not for the Docker setup (the container cannot start another container).
#SEESTAR_TUNNEL_COMMAND=docker compose run --service-ports --rm seestar
#SEESTAR_TUNNEL_CWD=/opt/seestar-portfwd
#SEESTAR_TUNNEL_READY_TIMEOUT_S=180

# ── Observer location (needed for planning, calibration, GoTo, polar alignment)
OBSERVER_LATITUDE=
OBSERVER_LONGITUDE=
OBSERVER_ELEVATION_M=30
# IANA timezone name used for all times the agent reports.
OBSERVER_TIMEZONE=America/New_York
# Units for weather in the UI and reports: metric (°C, km/h, mm, km) | imperial (°F, mph, in, mi).
UNITS=metric
# Default minimum altitude for target planning (trees/houses/haze).
PLAN_MIN_ALTITUDE_DEG=25

# ── The sky and the glass the plan judges every target against ──────────────
# Site sky class: 1 is a dark site, 5 is a suburb, 9 is inner city (fractions such as 6.6 from a
# light-pollution map are fine). This is the one number that
# moves the whole ladder of thresholds: what is reachable, how faint a surface the plan will
# chase, and how long a sub the sky rewards. Leave it at 5 until you have looked up your site.
PLAN_BORTLE=5
# The filters on the Dwarf 3: each target is planned through the best of them (named in suggestedFilter).
# An Ha region under a bare suburban sky is not a target; the same region through the Duo-Band is.
PLAN_FILTERS=Astro,Duo-Band
# Force one glass for every target instead (none | astro | duo-band | ha 7nm | optolong l-extreme …); empty = PLAN_FILTERS.
PLAN_FILTER=
# Clear aperture of the tele lens in mm — the one optics number the scope cannot report. Without
# it the plan still gives you the mount's own sub ceiling, and says which number is missing.
PLAN_APERTURE_MM=60
# Read noise in electrons of your camera. With it the sub advice is one number; without it the
# plan quotes the honest range from a modern sensor to an old one.
PLAN_READ_NOISE_E=1.5
# The Dwarf head is alt-az; a wedge or a pier-mounted rig changes what trails and how soon.
PLAN_MOUNT=alt-az
# Guiding removes the trailing ceiling entirely, so the sky alone sets the sub length.
PLAN_GUIDED=false
# Arcsec per pixel; the app's own tele plate scale is used when unset.
PLAN_PLATE_SCALE_ARCSEC=2.766
# The capture-settings planner (acquisition_plan) picks the scope's spec file from what it reports
# (devices/*.json: Dwarf 3, Dwarf Mini, Seestar S30, S30 Pro, S50, S50 Pro). Force one by its id:
#PLAN_DEVICE=seestar-s50-pro
# Your own models or corrections: drop a JSON file of the same shape into <DATA_DIR>/devices/.
# Zenith sky brightness from a sky meter (SQM), mag/arcsec². Wins over the rig's own sky
# measurements (acquisition_measure) and over PLAN_BORTLE.
#PLAN_SKY_SQM=21.6
# The swamp factor a sub should reach: the sky's noise squared over the read noise squared
# (sub_length measures it on a real sub, Deep Sky Detail's method). 10 is DSD's recommendation and
# what acquisition_plan quotes a sub against; 3–5 is the lenient school.
PLAN_SWAMP_FACTOR=10

# ── LLM (any OpenAI-compatible, vision-capable chat-completions endpoint) ────
LLM_BASE_URL=http://192.168.1.50:8000/v1
LLM_MODEL=Qwen/Qwen3.8-Flash-Next
LLM_API_KEY=none
# off | minimal | low | medium | high | xhigh
REASONING_EFFORT=medium
LLM_CONTEXT_WINDOW=131072
LLM_MAX_TOKENS=16384
# Request shape for thinking: openai | openai-responses | qwen | qwen-chat-template | zai | openrouter
# qwen for Qwen on vLLM: it is the shape that carries REASONING_EFFORT (reasoning_effort + chat_template_kwargs).
# openai-responses for OpenAI itself (api.openai.com, reasoning models such as GPT-5 and later): their chat
# completions refuse function tools while reasoning is on, so this talks to the Responses API (/v1/responses)
# with REASONING_EFFORT as reasoning.effort.
# Empty lets Oh My Pi pick, and for Qwen on vLLM it then sends no effort at all (the server default applies).
LLM_THINKING_FORMAT=qwen
# Send images (camera views, FITS previews) to the model. Set false for text-only models.
LLM_VISION=true
# Wake the agent when the telescope is plugged in to charge (brought back inside) with sessions still on
# its SD card: it parks the scope, transfers them (processing queues itself) and shuts the telescope down
# once every transfer is done. Never fires while imaging. Off: tell the agent what to do at the end of
# the session and it keeps that in its todo list.
PROMPT_TRANSFER_ON_CHARGE=false

# Duty loop: while the agent is on duty (an objective started from the chat panel or by the
# agent), Astrocontroller wakes it with fresh measurements every DUTY_INTERVAL_S seconds and at
# once on events (stack ended, dark master saved, transfer done, connection lost, low battery…).
DUTY_INTERVAL_S=300

# ── Imagery library ──────────────────────────────────────────────────────────
# Host folder that receives transferred sessions (FITS lights, stacks, calibration frames).
LIBRARY_PATH=./library

# ── Web UI ───────────────────────────────────────────────────────────────────
WEB_PORT=8080
# Docker container name; give each checkout its own so two stacks do not clash
# CONTAINER_NAME=astrocontroller
LIVE_STREAM_FPS=8
LIVE_STREAM_WIDTH=1280

# ── Stellarium tab ───────────────────────────────────────────────────────────
# The planetarium uses the observer location above and works offline from the bundled sky data
# (stars to mag 7, the bright deep-sky objects). true = also stream the online surveys: DSS colour
# imagery, Gaia stars, the full deep-sky catalog and the planet textures (needs internet).
STELLARIUM_STREAM=false
# Where they are streamed from (data.stellarium.org or a mirror of its layout).
STELLARIUM_DATA_URL=https://data.stellarium.org

# ── Processing (AstroPhoto Studio on a GPU server, e.g. over Tailscale) ───────
# Server URL; empty turns processing off.
ASTROPHOTO_URL=
# Restoration profile from the server's /api/v1/profiles: default (the server's own default: ImageMM
# with its Noise2Noise pass), imagemm (without the pass), n2n-network (Noise2Noise + deconvolution
# network, fast: done by morning), n2n-rl, …
ASTROPHOTO_PROFILE=default
# Queue processing automatically after every session transfer.
ASTROPHOTO_AUTO_PROCESS=true
# Auto-processing stacks the new night together with every earlier night of the same target,
# camera, scope (Dwarf / Seestar) and filter.
ASTROPHOTO_POOL_SESSIONS=false
# How the server gets the subs: auto (its own copy of the library if it has the session, else upload) | shared | upload
ASTROPHOTO_DATA_ACCESS=auto
# Where this library is as the server sees it: relative to the server's images folder ("" = the same
# folder, e.g. both point at the NAS Dwarf folder) or an absolute path on the server.
ASTROPHOTO_LIBRARY_PATH=
# Copy the finished JPEG/TIFF back into <session>/processed/ in the library.
ASTROPHOTO_FETCH_OUTPUTS=true
# Optional: a processing preset of the Studio UI, and JSON overrides of single settings.
ASTROPHOTO_PRESET=
ASTROPHOTO_STACK_PARAMS=
ASTROPHOTO_PARAMS=
# Seconds between outbox / job-status checks.
ASTROPHOTO_POLL_S=60
