# ── Telescope ────────────────────────────────────────────────────────────────
# IP of the Dwarf 3 on your network (STA mode). In AP mode it is 192.168.88.1.
DWARF_HOST=10.0.0.196
# Push time, timezone and location to the scope whenever we (re)connect.
DWARF_AUTO_SYNC_TIME_LOCATION=true

# ── Observer location (needed for planning, calibration, GoTo, polar alignment)
OBSERVER_LATITUDE=
OBSERVER_LONGITUDE=
OBSERVER_ELEVATION_M=30
# IANA timezone name used for all times the agent reports.
OBSERVER_TIMEZONE=America/New_York
# Default minimum altitude for target planning (trees/houses/haze).
PLAN_MIN_ALTITUDE_DEG=25

# ── LLM (any OpenAI-compatible, vision-capable chat-completions endpoint) ────
LLM_BASE_URL=http://192.168.1.50:8000/v1
LLM_MODEL=Qwen/Qwen3.8-Flash-Next
LLM_API_KEY=none
# off | minimal | low | medium | high | xhigh
REASONING_EFFORT=medium
LLM_CONTEXT_WINDOW=131072
LLM_MAX_TOKENS=16384
# Optional request shape for thinking: openai | qwen | qwen-chat-template | zai | openrouter
# Leave empty to let Oh My Pi pick (it auto-detects Qwen 3.8+ on vLLM).
LLM_THINKING_FORMAT=
# Send images (camera views, FITS previews) to the model. Set false for text-only models.
LLM_VISION=true
# Wake the agent when the telescope is plugged in to charge (brought back inside) with sessions still on
# its SD card: it parks the scope, transfers them (processing queues itself) and shuts the telescope down
# once every transfer is done. Never fires while imaging. Off: tell the agent what to do at the end of
# the session and it keeps that in its todo list.
PROMPT_TRANSFER_ON_CHARGE=false

# ── Imagery library ──────────────────────────────────────────────────────────
# Host folder that receives transferred sessions (FITS lights, stacks, calibration frames).
LIBRARY_PATH=./library

# ── Web UI ───────────────────────────────────────────────────────────────────
WEB_PORT=8080
LIVE_STREAM_FPS=8
LIVE_STREAM_WIDTH=1280

# ── Processing (AstroPhoto Studio on a GPU server, e.g. over Tailscale) ───────
# Server URL; empty turns processing off.
ASTROPHOTO_URL=
# Restoration profile from the server's /api/v1/profiles: default (the server's own default: ImageMM
# with its Noise2Noise pass), imagemm (without the pass), n2n-network (Noise2Noise + deconvolution
# network, fast: done by morning), n2n-rl, …
ASTROPHOTO_PROFILE=default
# Queue processing automatically after every session transfer.
ASTROPHOTO_AUTO_PROCESS=true
# Auto-processing stacks the new night together with every earlier night of the same target.
ASTROPHOTO_POOL_SESSIONS=false
# How the server gets the subs: auto (its own copy of the library if it has the session, else upload) | shared | upload
ASTROPHOTO_DATA_ACCESS=auto
# Where this library is as the server sees it: relative to the server's images folder ("" = the same
# folder, e.g. both point at the NAS Dwarf folder) or an absolute path on the server.
ASTROPHOTO_LIBRARY_PATH=
# Copy the finished JPEG/TIFF back into <session>/processed/ in the library.
ASTROPHOTO_FETCH_OUTPUTS=true
# Optional: a processing preset of the Studio UI, and JSON overrides of single settings.
ASTROPHOTO_PRESET=
ASTROPHOTO_STACK_PARAMS=
ASTROPHOTO_PARAMS=
# Seconds between outbox / job-status checks.
ASTROPHOTO_POLL_S=60
